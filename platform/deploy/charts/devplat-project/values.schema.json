{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "devplat-project chart values",
  "description": "Per-project bundle values, generated from the project configuration. Unknown keys are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "platformNamespace", "artifacts", "exec", "build", "test"],
  "definitions": {
    "dnsLabel": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63},
    "quantity": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi|Ti|k|M|G|T)?$"},
    "count": {"type": "string", "pattern": "^[0-9]+$"},
    "boundedObjects": {"type": "string", "pattern": "^([1-9][0-9]?|1[0-9]{2}|200)$", "description": "1..200: per-run ConfigMaps/Secrets must be possible, but bounded (doc 18 I-5)."},
    "cidr": {"type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$|^[0-9a-fA-F:]+/[0-9]{1,3}$"},
    "quota": {
      "type": "object", "additionalProperties": false,
      "required": ["requests.cpu", "limits.cpu", "requests.memory", "limits.memory", "requests.ephemeral-storage", "limits.ephemeral-storage", "pods", "count/jobs.batch", "persistentvolumeclaims", "requests.storage", "configmaps", "secrets"],
      "properties": {
        "requests.cpu": {"$ref": "#/definitions/quantity"}, "limits.cpu": {"$ref": "#/definitions/quantity"},
        "requests.memory": {"$ref": "#/definitions/quantity"}, "limits.memory": {"$ref": "#/definitions/quantity"},
        "requests.ephemeral-storage": {"$ref": "#/definitions/quantity"}, "limits.ephemeral-storage": {"$ref": "#/definitions/quantity"},
        "pods": {"$ref": "#/definitions/count"}, "count/jobs.batch": {"$ref": "#/definitions/count"},
        "persistentvolumeclaims": {"$ref": "#/definitions/count"}, "requests.storage": {"$ref": "#/definitions/quantity"},
        "configmaps": {"$ref": "#/definitions/boundedObjects"}, "secrets": {"$ref": "#/definitions/boundedObjects"}
      }
    },
    "resourceSet": {
      "type": "object", "additionalProperties": false, "required": ["cpu", "memory"],
      "properties": {"cpu": {"$ref": "#/definitions/quantity"}, "memory": {"$ref": "#/definitions/quantity"}, "ephemeral-storage": {"$ref": "#/definitions/quantity"}}
    },
    "limits": {
      "type": "object", "additionalProperties": false, "required": ["max", "min", "default", "defaultRequest", "pvcMaxStorage"],
      "properties": {
        "max": {"$ref": "#/definitions/resourceSet"}, "min": {"$ref": "#/definitions/resourceSet"},
        "default": {"$ref": "#/definitions/resourceSet"}, "defaultRequest": {"$ref": "#/definitions/resourceSet"},
        "pvcMaxStorage": {"$ref": "#/definitions/quantity"}
      }
    }
  },
  "properties": {
    "project": {
      "type": "object", "additionalProperties": false, "required": ["id", "namespacePrefix", "clusterRef"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,22}[a-z0-9]$", "description": "Short id; keeps proj-<id>-t-<8> and Job names within 63 characters."},
        "namespacePrefix": {"type": "string", "pattern": "^proj-[a-z][a-z0-9-]{0,22}[a-z0-9]$"},
        "clusterRef": {"$ref": "#/definitions/dnsLabel"}
      }
    },
    "platformNamespace": {"const": "devplat-system"},
    "artifacts": {
      "type": "object", "additionalProperties": false, "required": ["inCluster", "externalCidrs"],
      "properties": {
        "inCluster": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}},
        "externalCidrs": {"type": "array", "items": {"$ref": "#/definitions/cidr"}, "uniqueItems": true}
      }
    },
    "exec": {
      "type": "object", "additionalProperties": false, "required": ["requiredRuntimeClassName", "quota", "limits"],
      "properties": {
        "requiredRuntimeClassName": {"enum": ["", "gvisor", "kata"]},
        "quota": {"$ref": "#/definitions/quota"},
        "limits": {"$ref": "#/definitions/limits"}
      }
    },
    "build": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "allowedBuilderImages", "quota", "limits"],
      "properties": {
        "enabled": {"type": "boolean"},
        "allowedBuilderImages": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._-]+)+@sha256:[a-f0-9]{64}$"}, "uniqueItems": true},
        "quota": {"$ref": "#/definitions/quota"},
        "limits": {"$ref": "#/definitions/limits"}
      }
    },
    "test": {
      "type": "object", "additionalProperties": false,
      "required": ["maxConcurrentNamespaces", "ttlSecondsAfterSuccess", "ttlSecondsAfterFailure", "maxLifetimeSeconds", "quota", "sandboxEgress"],
      "properties": {
        "maxConcurrentNamespaces": {"type": "integer", "minimum": 0, "maximum": 20},
        "ttlSecondsAfterSuccess": {"type": "integer", "minimum": 0, "maximum": 86400},
        "ttlSecondsAfterFailure": {"type": "integer", "minimum": 0, "maximum": 86400},
        "maxLifetimeSeconds": {"type": "integer", "minimum": 300, "maximum": 86400},
        "quota": {"$ref": "#/definitions/quota"},
        "sandboxEgress": {
          "type": "object", "additionalProperties": false, "required": ["enabled", "egressCidrs"],
          "properties": {"enabled": {"type": "boolean"}, "egressCidrs": {"type": "array", "items": {"$ref": "#/definitions/cidr"}}}
        }
      }
    }
  }
}
