{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devplat.task_contract.v2",
  "title": "devplat task contract v2 (multi-project; Kubernetes execution)",
  "description": "Generalization of devorch.task_contract.v1 for devplat (Amendment 001). Changes: project_id; project-neutral ids and branches (branch prefix comes from the project config); kind plan_proposal for planner Jobs; created_by controller|operator; upstream_issue replaces merc_issue (merc_issue kept as a deprecated alias); worktree/evidence_dir are container paths fixed by the Job spec. Everything else is unchanged so devorch rules port 1:1. A v1 contract converts by: project_id=mercury, upstream_issue=merc_issue.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "contract_version",
    "kind",
    "linear_issue",
    "assigned_agent",
    "objective",
    "requirements",
    "dependencies",
    "approved_design_refs",
    "allowed_paths",
    "restricted_paths",
    "interface_contracts",
    "acceptance_criteria",
    "required_tests",
    "required_reviewers",
    "required_gates",
    "security_sensitive",
    "branch",
    "worktree",
    "base_commit",
    "evidence_dir",
    "status",
    "attempt",
    "budget",
    "created_at",
    "created_by",
    "project_id",
    "upstream_issue"
  ],
  "properties": {
    "schema": {
      "const": "devplat.task_contract.v2"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,7}-[0-9]{4,6}(-[a-z][0-9]{1,3})?$",
      "description": "<PREFIX>-nnnn, subtasks -rN/-sN/-iN/-pN (planner proposal)"
    },
    "contract_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Incremented when any field except status/attempt changes; earlier results are invalid for a new version."
    },
    "kind": {
      "enum": [
        "design",
        "planning",
        "implementation",
        "test",
        "security_review",
        "code_review",
        "design_review",
        "reliability_review",
        "reliability",
        "integration",
        "release",
        "mac_validation",
        "operator_action",
        "plan_proposal"
      ]
    },
    "linear_issue": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]+-[0-9]+$"
    },
    "merc_issue": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^MERC-[0-9A-Za-z]+$",
      "description": "DEPRECATED alias of upstream_issue (v1 compatibility)"
    },
    "assigned_agent": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$",
      "description": "Role id from the platform role catalogue (platform/agents/execution-profiles.yaml) or a non-Job actor (operator, mac-validation-queue); must be an executor of `kind` in the catalogue and enabled in the project config (checked at register_contract, R6 D6/D7)."
    },
    "objective": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]{1,9}-[0-9A-Za-z.-]{1,20}$"
      },
      "description": "Requirement ids of the project (e.g. Mercury CON-/FR-/NFR-/SEC-); vocabulary from the project's documentation."
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "required_state"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{1,7}-[0-9]{4,6}(-[a-z][0-9]{1,3})?$"
          },
          "required_state": {
            "enum": [
              "COMPLETED",
              "AWAITING_HUMAN",
              "INTERFACE_FROZEN"
            ]
          },
          "project_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,22}[a-z0-9]$",
            "description": "Only for a declared cross-project dependency; default = this contract's project."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "INTERFACE_FROZEN only: the frozen interface file (repository-relative). DB task_dependencies.path."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "INTERFACE_FROZEN only: the sha256 the dependency must have frozen for path (its interface_frozen frozen_files). DB task_dependencies.sha256."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "required_state": {
                  "const": "INTERFACE_FROZEN"
                }
              },
              "required": [
                "required_state"
              ]
            },
            "then": {
              "required": [
                "path",
                "sha256"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "path"
                    ]
                  },
                  {
                    "required": [
                      "sha256"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "approved_design_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "description": "path§section@commit, e.g. docs/mercury/architecture/components.md§6.3@<sha>"
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "description": "glob relative to repo root"
      },
      "description": "globs relative to repo root ('**/' any dirs, '*' no slash); [] for read-only kinds"
    },
    "restricted_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interface_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "frozen_by"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "frozen_by": {
            "type": "string",
            "pattern": "^DT-[0-9]{4}(-[a-z0-9]+)?$"
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "required_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "TC-<LEVEL>-nnn or local name"
          },
          "command": {
            "type": "string"
          },
          "env": {
            "enum": [
              "T0",
              "T1",
              "T2",
              "T3",
              "T4",
              "T4v",
              "T5",
              "CI-linux",
              "CI-macos"
            ]
          }
        }
      }
    },
    "required_reviewers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,40}$"
      },
      "description": "Role ids from the platform role catalogue whose catalogue kind has a gate (G3/G4), or 'operator'. Checked by the controller against the catalogue and the project config (R6 D6)."
    },
    "required_gates": {
      "type": "array",
      "items": {
        "enum": [
          "G1",
          "G2",
          "G3",
          "G4",
          "G5",
          "G6",
          "G7"
        ]
      }
    },
    "mercury_gates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(G-S[1-5]|P0-[0-9]+|SAC-[0-9]+)$"
      },
      "description": "DEPRECATED alias of required_facts (v1 compatibility); the controller merges both."
    },
    "security_sensitive": {
      "type": "boolean"
    },
    "branch": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,15}/[a-z0-9][a-z0-9-]{1,60}$",
      "description": "must start with the project's pr_policy branch prefix (checked by the controller)"
    },
    "worktree": {
      "const": "/workspace/repo"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "evidence_dir": {
      "const": "/out"
    },
    "status": {
      "enum": [
        "READY",
        "BLOCKED",
        "RUNNING",
        "AWAITING_REVIEW",
        "AWAITING_INTEGRATION",
        "AWAITING_HUMAN",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "max_turns",
        "max_wall_minutes"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "max_wall_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 480
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "review_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_task_id",
        "base_commit",
        "head_commit"
      ],
      "properties": {
        "implementation_task_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,7}-[0-9]{4,6}(-[a-z][0-9]{1,3})?$"
        },
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 4000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "enum": [
        "devplat-controller",
        "operator"
      ],
      "description": "planner Jobs only PROPOSE contracts; the controller creates them"
    },
    "parent_task_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,7}-[0-9]{4,6}(-[a-z][0-9]{1,3})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "covers_tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]{1,7}-[0-9]{4,6}(-[a-z][0-9]{1,3})?$"
      }
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,22}[a-z0-9]$",
      "description": "devplat.project.v1 project id (<= 24 characters, R6 D24). Task identity is (project_id, task_id) (R6 D3)."
    },
    "upstream_issue": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64,
      "description": "the project's own issue id (e.g. MERC-101); null for subtasks"
    },
    "required_facts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]*(-[A-Za-z0-9]+)+$"
      },
      "description": "Per-task operator facts that must be recorded for THIS project before G1 (DB task_required_facts, R6 D7), e.g. Mercury G-S1, P0-12. Hard preconditions (DOD-02, DOD-13) come from the project config and are not listed here."
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "enum": [
            "controller",
            "planner",
            "operator"
          ]
        },
        "planner_task_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,7}-[0-9]{4,6}(-[a-z][0-9]{1,3})?$",
          "description": "plan_proposal subtask that proposed this contract"
        },
        "approval_ref": {
          "type": "string",
          "minLength": 1,
          "description": "devplat-api operator approval record; required before READY for planner-originated contracts and for every contract_revised (R6 D18)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "planner"
              }
            }
          },
          "then": {
            "required": [
              "planner_task_id",
              "approval_ref"
            ]
          }
        }
      ]
    }
  }
}
