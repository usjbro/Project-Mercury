{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devplat.invalid/schemas/handoff.v2.schema.json",
  "title": "devplat task event / handoff record v2 (devplat.handoff.v2)",
  "description": "Export and wire form of one row of the PostgreSQL task_events table (19-postgresql-state.md): append-only, hash-chained per (project_id, task_id), written only by devplat-controller through record_event(). Generalizes devorch.handoff.v1: project scoping, the controller as the only writer (operators act through devplat-api and appear as on_behalf_of), lease fencing, idempotency, config_version and assurance mode (R6 D3, D8, D23). Event and state vocabularies are unchanged from v1 so the devorch rules port 1:1. The canonical hash form is defined by the DB (event_canonical), not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor",
    "assurance_mode",
    "at",
    "attempt",
    "config_version",
    "contract_core_sha256",
    "contract_version",
    "controller_id",
    "event",
    "evidence",
    "from_state",
    "hash",
    "lease_token",
    "prev_hash",
    "project_id",
    "schema",
    "seq",
    "task_id",
    "to_state"
  ],
  "properties": {
    "schema": {
      "const": "devplat.handoff.v2"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,22}[a-z0-9]$",
      "description": "devplat.project.v1 project id (<= 24 characters, R6 D24)."
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,7}-[0-9]{4,6}(-[a-z][0-9]{1,3})?$",
      "description": "<PREFIX>-nnnn (prefix from the project config); subtasks -rN/-sN/-iN/-pN. Unique per project: identity is (project_id, task_id) (R6 D3)."
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "event": {
      "enum": [
        "assigned",
        "attempt_failed",
        "awaiting_human",
        "cancelled",
        "closed",
        "code_review_changes_required",
        "code_review_passed",
        "contract_revised",
        "created",
        "dispatched",
        "env_retry",
        "escalated",
        "failed",
        "human_changes_requested",
        "human_merged",
        "implementation_completed",
        "integration_failed",
        "integration_verified",
        "interface_frozen",
        "pr_prepared",
        "reclaimed",
        "result_accepted",
        "resumed",
        "security_review_blocked",
        "security_review_passed",
        "stale_detected",
        "started",
        "tests_failed",
        "tests_passed",
        "unblocked"
      ]
    },
    "from_state": {
      "enum": [
        "NEW",
        "READY",
        "BLOCKED",
        "RUNNING",
        "AWAITING_REVIEW",
        "AWAITING_INTEGRATION",
        "AWAITING_HUMAN",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "to_state": {
      "enum": [
        "READY",
        "BLOCKED",
        "RUNNING",
        "AWAITING_REVIEW",
        "AWAITING_INTEGRATION",
        "AWAITING_HUMAN",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "actor": {
      "const": "devplat-controller",
      "description": "The only writer. Agents and planners never write events."
    },
    "contract_version": {
      "type": "integer"
    },
    "attempt": {
      "type": "integer"
    },
    "gate": {
      "enum": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6",
        "G7"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "approval",
              "artifact",
              "ci_run",
              "commit",
              "contract",
              "design_ref",
              "github_merge",
              "log",
              "operator_fact",
              "operator_statement",
              "pr",
              "result_file",
              "review_file",
              "subtask",
              "test_run"
            ]
          },
          "ref": {
            "type": "string",
            "description": "File evidence: content address sha256/<hex> in the project's artifact bucket; otherwise a URL, commit, subtask id or fact id."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source": {
            "type": "string",
            "description": "Provenance only, e.g. runs/<job-uid>/result.json or pod log (API read)."
          }
        }
      }
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^([0-9a-f]{64}|GENESIS)$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contract_core_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of the contract without status/attempt; may change only via contract_revised"
    },
    "head_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "frozen_files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "controller_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Lease holder (controller pod identity)."
    },
    "on_behalf_of": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[^#\\s]+#[^#\\s]+$"
        },
        {
          "type": "null"
        }
      ],
      "description": "<issuer>#<subject> of the authenticated operator when the event cites an operator fact or approval (R6 D2)."
    },
    "lease_token": {
      "type": "integer",
      "minimum": 0,
      "description": "Fencing token of the task lease under which the event was written."
    },
    "idempotency_key": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "config_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Project config version the event was decided under (R6 D8)."
    },
    "assurance_mode": {
      "enum": [
        "standard",
        "reduced"
      ],
      "description": "reduced = installation or project in declared reduced-assurance mode (R6 D16)."
    },
    "dispatch_no": {
      "type": "integer",
      "minimum": 1,
      "description": "dispatched / env_retry: Job dispatch number within the attempt (jobspec.py)."
    },
    "job_uid": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$",
      "description": "dispatched: Kubernetes Job uid (replaces v1 session)."
    },
    "payload": {
      "type": "object",
      "description": "Event-specific data (e.g. the accepted result summary, hold reason)."
    }
  }
}
