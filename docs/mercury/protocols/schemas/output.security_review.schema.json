{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.mercury.local/v1/output.security_review.schema.json",
  "title": "Claude PR security review verdict",
  "description": "Output of claude_security_review. Severity policy in code: critical => BLOCKED(security_escalation); high => revise.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "mercury.output.security_review.v1"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "issue_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{0,9}-[0-9]{1,7}$"
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
        },
        "auth_id": {
          "type": "string",
          "pattern": "^auth_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "diff_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "request_id",
        "task_id",
        "input_digest",
        "issue_id",
        "repo",
        "auth_id",
        "head_sha",
        "base_sha",
        "diff_sha256"
      ]
    },
    "decision": {
      "enum": [
        "approve",
        "revise",
        "reject",
        "needs_human"
      ]
    },
    "checked_areas": {
      "type": "array",
      "items": {
        "enum": [
          "injection",
          "authn",
          "authz",
          "secrets",
          "crypto",
          "dependencies",
          "supply_chain",
          "input_validation",
          "path_traversal",
          "ssrf",
          "deserialization",
          "logging",
          "configuration",
          "ci_workflows",
          "prompt_injection"
        ]
      },
      "minItems": 1,
      "maxItems": 15
    },
    "files_reviewed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SEC[0-9]{1,3}$"
          },
          "category": {
            "enum": [
              "injection",
              "authn",
              "authz",
              "secrets",
              "crypto",
              "dependencies",
              "supply_chain",
              "input_validation",
              "path_traversal",
              "ssrf",
              "deserialization",
              "logging",
              "configuration",
              "ci_workflows",
              "prompt_injection_attempt",
              "other"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "cwe": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^CWE-[0-9]{1,5}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "exploitability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "end_line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "required_change": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "category",
          "severity",
          "cwe",
          "title",
          "detail",
          "exploitability",
          "path",
          "line",
          "end_line",
          "required_change"
        ]
      },
      "minItems": 0,
      "maxItems": 100
    },
    "prior_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finding_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "status": {
            "enum": [
              "resolved",
              "unresolved",
              "partially_resolved",
              "disputed"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        },
        "required": [
          "finding_ref",
          "status",
          "note"
        ]
      },
      "minItems": 0,
      "maxItems": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "escalation_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "injection_suspected": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "binding",
    "decision",
    "checked_areas",
    "files_reviewed",
    "findings",
    "prior_findings",
    "summary",
    "escalation_reason",
    "injection_suspected"
  ]
}
