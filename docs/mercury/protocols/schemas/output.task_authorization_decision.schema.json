{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.mercury.local/v1/output.task_authorization_decision.schema.json",
  "title": "Claude authorization decision",
  "description": "Output of a claude_authorize run (initial or reauthorize). Scope may only narrow the offered repo policy (SEC-305). Coordinator writes the auth_ record.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "mercury.output.task_authorization_decision.v1"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "issue_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{0,9}-[0-9]{1,7}$"
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
        },
        "spec_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "request_id",
        "task_id",
        "input_digest",
        "issue_id",
        "repo",
        "spec_sha256"
      ]
    },
    "decision": {
      "enum": [
        "authorize",
        "decline",
        "defer",
        "needs_spec",
        "needs_human"
      ]
    },
    "scope": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "summary",
        "in_scope",
        "out_of_scope",
        "acceptance_criteria",
        "allowed_path_globs",
        "denied_path_globs",
        "max_files_changed",
        "max_loc_changed",
        "dependency_changes_allowed",
        "ask_first_categories",
        "requires_security_review"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 50
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 0,
          "maxItems": 50
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ac_id": {
                "type": "string",
                "pattern": "^AC-[0-9]{1,3}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "ac_id",
              "text"
            ]
          },
          "minItems": 0,
          "maxItems": 100
        },
        "allowed_path_globs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "minItems": 1,
          "maxItems": 100
        },
        "denied_path_globs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "minItems": 0,
          "maxItems": 200
        },
        "max_files_changed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "max_loc_changed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "dependency_changes_allowed": {
          "enum": [
            false,
            "escalate"
          ]
        },
        "ask_first_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "minItems": 0,
          "maxItems": 20
        },
        "requires_security_review": {
          "type": "boolean"
        }
      }
    },
    "limits": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "max_plan_revisions",
        "max_pr_revisions",
        "max_verify_fix_cycles",
        "max_codex_awake_minutes",
        "network",
        "expires_in_hours"
      ],
      "properties": {
        "max_plan_revisions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "max_pr_revisions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "max_verify_fix_cycles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "max_codex_awake_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "network": {
          "enum": [
            "none",
            "deps_only"
          ]
        },
        "expires_in_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 336
        }
      }
    },
    "priority": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 4
    },
    "defer_until_hours": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 336
    },
    "spec_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 0,
      "maxItems": 20
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 0,
      "maxItems": 20
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "injection_suspected": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "binding",
    "decision",
    "scope",
    "limits",
    "priority",
    "defer_until_hours",
    "spec_questions",
    "risk_flags",
    "rationale",
    "injection_suspected"
  ]
}
