{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mercury.local/v1/common.schema.json",
  "title": "MERCURY common definitions",
  "description": "Shared $defs referenced by message schemas. Not a message itself.",
  "$defs": {
    "task_id": {
      "type": "string",
      "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "message_id": {
      "type": "string",
      "pattern": "^msg_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^auth_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^pln_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "review_id": {
      "type": "string",
      "pattern": "^rev_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^apr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^fnd_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "revision_request_id": {
      "type": "string",
      "pattern": "^rrq_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "test_result_id": {
      "type": "string",
      "pattern": "^tst_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "pr_id": {
      "type": "string",
      "pattern": "^prq_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "outbox_id": {
      "type": "string",
      "pattern": "^obx_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^ins_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "verification_id": {
      "type": "string",
      "pattern": "^mvf_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
    },
    "issue": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{0,9}-[0-9]{1,7}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "ac_id": {
      "type": "string",
      "pattern": "^AC-[0-9]{1,3}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "actor": {
      "type": "string",
      "pattern": "^(coordinator|operator|claude:[a-z_]{1,40}|codex:[a-z_]{1,40}|github:[A-Za-z0-9\\[\\]-]{1,60}|linear:[A-Za-z0-9-]{1,60})$",
      "description": "SEC-601 actor vocabulary (Agent E C-SEC-5)."
    },
    "task_state": {
      "enum": [
        "AWAITING_AUTHORIZATION",
        "AUTHORIZED",
        "PLANNING",
        "AWAITING_PLAN_REVIEW",
        "PLAN_REVISION_REQUESTED",
        "PLAN_APPROVED",
        "IMPLEMENTING",
        "TESTING",
        "PR_OPEN",
        "CLAUDE_PR_REVIEW",
        "CHANGES_REQUESTED",
        "AWAITING_HUMAN_APPROVAL",
        "MERGED",
        "BLOCKED",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "severity": {
      "enum": [
        "blocking",
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/artifact_id"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "media_type",
        "size_bytes"
      ]
    },
    "authorization_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authorization_id": {
          "$ref": "#/$defs/authorization_id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "scope_version": {
          "type": "integer",
          "minimum": 1
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "authorization_id",
        "version",
        "scope_version",
        "payload_sha256"
      ]
    },
    "plan_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "$ref": "#/$defs/plan_id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "plan_id",
        "version",
        "sha256"
      ]
    },
    "pr_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "head_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "base_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "diff_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "number",
        "head_sha",
        "base_sha",
        "diff_sha256"
      ]
    },
    "agent_info": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "enum": [
            "claude",
            "codex",
            "coordinator"
          ]
        },
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "agent_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        }
      },
      "required": [
        "agent",
        "run_id",
        "model",
        "agent_version",
        "session_id"
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "end_line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "side": {
          "enum": [
            "RIGHT",
            "LEFT",
            null
          ]
        }
      },
      "required": [
        "path",
        "line",
        "end_line",
        "side"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "$ref": "#/$defs/finding_id"
        },
        "local_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "source_kind": {
          "enum": [
            "plan_review",
            "code_review",
            "security_review",
            "local_tests",
            "ci",
            "human_review",
            "diff_gate",
            "secret_scan",
            "merge_conflict"
          ]
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "cwe": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "location": {
          "oneOf": [
            {
              "$ref": "#/$defs/location"
            },
            {
              "type": "null"
            }
          ]
        },
        "required_change": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4000
        }
      },
      "required": [
        "finding_id",
        "local_id",
        "source_kind",
        "severity",
        "category",
        "cwe",
        "title",
        "detail",
        "location",
        "required_change"
      ]
    }
  }
}
