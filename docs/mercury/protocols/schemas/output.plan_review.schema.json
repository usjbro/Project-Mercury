{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.mercury.local/v1/output.plan_review.schema.json",
  "title": "Claude plan review verdict",
  "description": "Output of claude_plan_review. V4: approve forbids blocking/critical/high findings and any criterion=fail; revise needs >=1 required_change; all 9 criteria exactly once; every AC id present.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "mercury.output.plan_review.v1"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "issue_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{0,9}-[0-9]{1,7}$"
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
        },
        "spec_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "auth_id": {
          "type": "string",
          "pattern": "^auth_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "pln_id": {
          "type": "string",
          "pattern": "^pln_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "request_id",
        "task_id",
        "input_digest",
        "issue_id",
        "repo",
        "spec_sha256",
        "auth_id",
        "pln_id",
        "plan_sha256"
      ]
    },
    "decision": {
      "enum": [
        "approve",
        "revise",
        "reject",
        "needs_human"
      ],
      "type": "string"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "criterion": {
            "enum": [
              "spec_compliance",
              "ac_coverage",
              "architecture",
              "dependencies",
              "security",
              "test_strategy",
              "scope",
              "feasibility",
              "maintainability"
            ],
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "concern",
              "not_applicable"
            ],
            "type": "string"
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "criterion",
          "result",
          "notes"
        ]
      },
      "minItems": 9,
      "maxItems": 9
    },
    "ac_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ac_id": {
            "type": "string",
            "pattern": "^AC-[0-9]{1,3}$"
          },
          "covered": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "ac_id",
          "covered",
          "evidence"
        ]
      },
      "minItems": 0,
      "maxItems": 100
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P[0-9]{1,3}$"
          },
          "category": {
            "enum": [
              "spec",
              "ac",
              "architecture",
              "security",
              "tests",
              "scope",
              "maintainability",
              "dependency",
              "prompt_injection_attempt",
              "other"
            ],
            "type": "string"
          },
          "severity": {
            "enum": [
              "blocking",
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ],
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "end_line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "required_change": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "category",
          "severity",
          "title",
          "detail",
          "path",
          "line",
          "end_line",
          "required_change"
        ]
      },
      "minItems": 0,
      "maxItems": 100
    },
    "approval_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 0,
      "maxItems": 30
    },
    "prior_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finding_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "status": {
            "enum": [
              "resolved",
              "unresolved",
              "partially_resolved",
              "disputed"
            ],
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        },
        "required": [
          "finding_ref",
          "status",
          "note"
        ]
      },
      "minItems": 0,
      "maxItems": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "escalation_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "injection_suspected": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "binding",
    "decision",
    "criteria",
    "ac_coverage",
    "findings",
    "approval_conditions",
    "prior_findings",
    "summary",
    "escalation_reason",
    "injection_suspected"
  ]
}
