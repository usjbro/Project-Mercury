{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.mercury.local/v1/output.codex_implementation.schema.json",
  "title": "Codex implementation result",
  "description": "Codex --output-schema for codex_implement / codex_revise. Advisory: the coordinator computes the real diff and runs authoritative tests.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "mercury.output.codex_implementation.v1"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "pln_id": {
          "type": "string",
          "pattern": "^pln_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "auth_id": {
          "type": "string",
          "pattern": "^auth_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      },
      "required": [
        "request_id",
        "task_id",
        "pln_id",
        "plan_sha256",
        "auth_id"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked",
        "needs_plan_change"
      ],
      "type": "string"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "step_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^S[0-9]{1,3}$"
          },
          "status": {
            "enum": [
              "done",
              "skipped",
              "deviated"
            ],
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        },
        "required": [
          "step_id",
          "status",
          "note"
        ]
      },
      "minItems": 0,
      "maxItems": 60
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 0,
      "maxItems": 500
    },
    "tests_run": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "passed": {
            "type": [
              "integer",
              "null"
            ]
          },
          "failed": {
            "type": [
              "integer",
              "null"
            ]
          },
          "skipped": {
            "type": [
              "integer",
              "null"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "command",
          "exit_code",
          "passed",
          "failed",
          "skipped",
          "summary"
        ]
      },
      "minItems": 0,
      "maxItems": 50
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "plan_step_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 10
          }
        },
        "required": [
          "description",
          "reason",
          "plan_step_id"
        ]
      },
      "minItems": 0,
      "maxItems": 30
    },
    "addressed_instructions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "instruction_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "resolution": {
            "enum": [
              "done",
              "partially_done",
              "not_done",
              "disputed"
            ],
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        },
        "required": [
          "instruction_id",
          "resolution",
          "note"
        ]
      },
      "minItems": 0,
      "maxItems": 50
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "follow_ups": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 0,
      "maxItems": 20
    }
  },
  "required": [
    "schema",
    "binding",
    "status",
    "summary",
    "step_results",
    "files_changed",
    "tests_run",
    "deviations",
    "addressed_instructions",
    "blocked_reason",
    "follow_ups"
  ]
}
