{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/usjbro/Project-Mercury/docs/mercury/development-orchestration/schemas/task-contract.schema.json",
  "title": "MERCURY development task contract (devorch.task_contract.v1)",
  "description": "Dispatched by the Principal Orchestrator to one specialist. Development-orchestration only; NOT a production MERCURY message.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "contract_version",
    "kind",
    "linear_issue",
    "merc_issue",
    "assigned_agent",
    "objective",
    "requirements",
    "dependencies",
    "approved_design_refs",
    "allowed_paths",
    "restricted_paths",
    "interface_contracts",
    "acceptance_criteria",
    "required_tests",
    "required_reviewers",
    "required_gates",
    "security_sensitive",
    "branch",
    "worktree",
    "base_commit",
    "evidence_dir",
    "status",
    "attempt",
    "budget",
    "created_at",
    "created_by"
  ],
  "properties": {
    "schema": {
      "const": "devorch.task_contract.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^DT-[0-9]{4}(-[a-z0-9]+)?$"
    },
    "contract_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Incremented when any field except status/attempt changes; earlier results are invalid for a new version."
    },
    "kind": {
      "enum": [
        "design",
        "planning",
        "implementation",
        "test",
        "security_review",
        "code_review",
        "reliability",
        "integration",
        "release",
        "mac_validation",
        "operator_action"
      ]
    },
    "linear_issue": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]+-[0-9]+$"
    },
    "merc_issue": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^MERC-[0-9A-Za-z]+$",
      "description": "Issue ID from docs/mercury/planning/issue-breakdown.md"
    },
    "assigned_agent": {
      "enum": [
        "mdev-lead-architect",
        "mdev-tpm",
        "mdev-backend-engineer",
        "mdev-database-engineer",
        "mdev-ai-integration-engineer",
        "mdev-platform-integration-engineer",
        "mdev-security-engineer",
        "mdev-devops-engineer",
        "mdev-test-automation-engineer",
        "mdev-reliability-engineer",
        "mdev-code-reviewer",
        "mdev-integration-release-engineer",
        "operator",
        "mac-validation-queue"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(CON|FR|NFR|OPS|SEC)-[0-9]+"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "required_state"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^DT-[0-9]{4}(-[a-z0-9]+)?$"
          },
          "required_state": {
            "enum": [
              "COMPLETED",
              "AWAITING_HUMAN",
              "INTERFACE_FROZEN"
            ]
          }
        }
      }
    },
    "approved_design_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "description": "path\u00a7section@commit, e.g. docs/mercury/architecture/components.md\u00a76.3@<sha>"
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "description": "glob relative to repo root"
      }
    },
    "restricted_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interface_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "frozen_by"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "frozen_by": {
            "type": "string",
            "pattern": "^DT-[0-9]{4}(-[a-z0-9]+)?$"
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "required_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "TC-<LEVEL>-nnn or local name"
          },
          "command": {
            "type": "string"
          },
          "env": {
            "enum": [
              "T0",
              "T1",
              "T2",
              "T3",
              "T4",
              "T4v",
              "T5",
              "CI-linux",
              "CI-macos"
            ]
          }
        }
      }
    },
    "required_reviewers": {
      "type": "array",
      "items": {
        "enum": [
          "mdev-code-reviewer",
          "mdev-security-engineer",
          "mdev-lead-architect",
          "mdev-reliability-engineer",
          "operator"
        ]
      }
    },
    "required_gates": {
      "type": "array",
      "items": {
        "enum": [
          "G1",
          "G2",
          "G3",
          "G4",
          "G5",
          "G6",
          "G7"
        ]
      }
    },
    "mercury_gates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(G-S[1-5]|P0-[0-9]+|SAC-[0-9]+)$"
      },
      "description": "TDD security gates / Phase 0 checks that must be satisfied before READY"
    },
    "security_sensitive": {
      "type": "boolean"
    },
    "branch": {
      "type": "string",
      "pattern": "^dev/(merc-[0-9a-z]+|dt-[0-9]{4})-[a-z0-9-]{1,40}$"
    },
    "worktree": {
      "type": "string",
      "description": "absolute path"
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "evidence_dir": {
      "type": "string",
      "description": "absolute path inside DEVORCH_HOME/evidence/<task_id>/attempt-<n>/"
    },
    "status": {
      "enum": [
        "READY",
        "BLOCKED",
        "RUNNING",
        "AWAITING_REVIEW",
        "AWAITING_INTEGRATION",
        "AWAITING_HUMAN",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "max_turns",
        "max_wall_minutes"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "max_wall_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 480
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "review_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_task_id",
        "base_commit",
        "head_commit"
      ],
      "properties": {
        "implementation_task_id": {
          "type": "string",
          "pattern": "^DT-[0-9]{4}(-[a-z0-9]+)?$"
        },
        "base_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "head_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 4000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "const": "principal-orchestrator"
    }
  }
}